# =============================================================================
#  Programmes 2027 — configuration Apache (compatible hébergement IONOS mutualisé)
# =============================================================================

Options -Indexes
DirectoryIndex index.php

<IfModule mod_rewrite.c>
  RewriteEngine On
  # RewriteBase /            # à décommenter et ajuster si le site est dans un sous-dossier

  # Les données ne doivent jamais être servies directement
  RewriteRule ^data/ - [F,L]
  RewriteRule ^inc/  - [F,L]

  # URLs propres : /candidat/marine-le-pen  →  candidat.php?id=marine-le-pen
  RewriteRule ^candidat/([a-z0-9-]+)/?$ candidat.php?id=$1 [L,QSA]
  RewriteRule ^comparer/?$              comparateur.php    [L,QSA]
  RewriteRule ^methodologie/?$          methodologie.php   [L,QSA]
  RewriteRule ^mentions-legales/?$      mentions-legales.php [L,QSA]

  # Forcer HTTPS et le www (à activer une fois le certificat IONOS en place)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
  Header set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css            "access plus 1 month"
  ExpiresByType image/svg+xml       "access plus 1 month"
  ExpiresByType image/jpeg          "access plus 1 month"
  ExpiresByType image/webp          "access plus 1 month"
  ExpiresByType text/html           "access plus 0 seconds"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>

ErrorDocument 404 /index.php
